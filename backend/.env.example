# Environment variables for Secure Notes Backend

# Database
DATABASE_URL="file:../database/notes.db"

# Session secret - change this to a random string in production
SESSION_SECRET="your-secret-key-change-this"

# Server
PORT=3001
NODE_ENV=development

# AES encryption key - must be exactly 32 bytes (hex encoded = 64 chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
